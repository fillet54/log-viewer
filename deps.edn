{:paths ["src/clj" "src/cljs" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.11.3"}
        org.clojure/clojurescript {:mvn/version "1.11.132"}
        com.stuartsierra/component {:mvn/version "1.1.0"}
        metosin/reitit-ring {:mvn/version "0.7.2"}
        ring/ring-core {:mvn/version "1.12.1"}
        ring/ring-jetty-adapter {:mvn/version "1.12.1"}
        ring/ring-defaults {:mvn/version "0.5.0"}
        no.cjohansen/replicant {:mvn/version "2025.12.1"}
        reagent/reagent {:mvn/version "1.2.0"}
        re-frame/re-frame {:mvn/version "1.4.3"}
        cljsjs/react {:mvn/version "17.0.2-0"}
        cljsjs/react-dom {:mvn/version "17.0.2-0"}}
 :aliases
 {:run {:main-opts ["-m" "eventlog.main"]}
 :sample-core-event {:main-opts ["-m" "eventlog.sample.core-event"]}
  :build-cljs {:main-opts ["-m" "cljs.main" "-co" "cljs.edn" "-c" "eventlog.app"]}
  :watch-cljs {:main-opts ["-m" "cljs.main" "-co" "cljs.edn" "-w" "src/cljs" "-c" "eventlog.app"]}
  :portfolio {:extra-deps {no.cjohansen/portfolio {:mvn/version "2026.03.1"}}}
  :figwheel {:extra-deps {com.bhauman/figwheel-main {:mvn/version "0.2.20"}
                          no.cjohansen/portfolio {:mvn/version "2026.03.1"}}
             :main-opts ["-m" "figwheel.main"]}}}
